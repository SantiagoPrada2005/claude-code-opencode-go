# OpenCode Go API key — get yours at https://opencode.ai/auth
OPENCODE_API_KEY=sk-your-key-here

# Proxy listen address (default: 127.0.0.1 — localhost only, safe)
# Use 0.0.0.0 to expose on all network interfaces (less secure)
# PROXY_HOST=127.0.0.1

# Proxy listen port — 11434 is the Ollama standard for local LLM APIs
# PROXY_PORT=11434

# Upstream API endpoint
# OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1/chat/completions

# Models exposed via /v1/models (comma-separated)
# Available at OpenCode Go: deepseek-v4-pro, deepseek-v4-flash, kimi-k2.6,
#   kimi-k2.5, glm-5.1, glm-5, qwen3.6-plus, qwen3.5-plus, mimo-v2-pro,
#   mimo-v2-omni, mimo-v2.5-pro, mimo-v2.5, minimax-m2.7, minimax-m2.5
# AVAILABLE_MODELS=deepseek-v4-pro,deepseek-v4-flash
